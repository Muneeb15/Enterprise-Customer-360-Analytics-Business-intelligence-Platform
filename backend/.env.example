# Copy to .env and fill in real values before running.

# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=development           # development | production
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Clerk Authentication ────────────────────────────────────────────────────────
# Get from https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_test_1uKe7SaHiF7WXksd8y9mWrRaOkjp7ofgygS28a6B9S
CLERK_PUBLISHABLE_KEY=pk_test_Y2xhc3NpYy1lc2NhcmdvdC0xNS5jbGVyay5hY2NvdW50cy5kZXYk

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://nexus:password@localhost:5432/nexus

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# ── Storage ────────────────────────────────────────────────────────────────────
# Local path where generated PDFs are stored (absolute or relative to project root)
STORAGE_PATH=./storage/reports

# ── Server ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
